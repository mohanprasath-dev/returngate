# PayPal sandbox only. Never commit real values.
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Database (Neon Postgres)
DATABASE_URL=

# Vision (Gemini Flash). NEEDS INPUT: confirm current model string in console
GEMINI_API_KEY=
GEMINI_MODEL=

# App
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=

# Cost and abuse caps
VISION_DAILY_CAP=250
VISION_PER_IP_HOURLY=10
WORKSPACE_REFUND_CAP_CENTS=5000

# Client-safe values only (sandbox buyer shown to judges)
NEXT_PUBLIC_SANDBOX_BUYER_EMAIL=
NEXT_PUBLIC_SANDBOX_BUYER_PASSWORD=
